#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/Users/wangxue/team-business-hub/node_modules/.pnpm/@giszhc+xlsx@0.20.4/node_modules/@giszhc/xlsx/node_modules:/Users/wangxue/team-business-hub/node_modules/.pnpm/@giszhc+xlsx@0.20.4/node_modules:/Users/wangxue/team-business-hub/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/Users/wangxue/team-business-hub/node_modules/.pnpm/@giszhc+xlsx@0.20.4/node_modules/@giszhc/xlsx/node_modules:/Users/wangxue/team-business-hub/node_modules/.pnpm/@giszhc+xlsx@0.20.4/node_modules:/Users/wangxue/team-business-hub/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../@giszhc/xlsx/bin/xlsx.njs" "$@"
else
  exec node  "$basedir/../@giszhc/xlsx/bin/xlsx.njs" "$@"
fi
